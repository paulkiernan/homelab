{
  enabled: true,
  semanticCommits: 'enabled',
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Renovate Dashboard',
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  rebaseWhen: 'conflicted',
  prCreation: 'immediate',
  prConcurrentLimit: 0,
  platformAutomerge: true,
  automergeStrategy: 'squash',
  argocd: {
    managerFilePatterns: [
      '/kubernetes/argocd/apps/.+\\.yaml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/kubernetes/.+\\.yaml$/',
    ],
  },
  customManagers: [
    {
      // Images set as repository/tag pairs in Helm values inside Argo CD
      // Applications (e.g. cloudflared, grafana-image-renderer) are invisible
      // to the argocd and kubernetes managers.
      customType: 'regex',
      managerFilePatterns: [
        '/kubernetes/argocd/apps/.+/application\\.yaml$/',
      ],
      matchStrings: [
        'repository:\\s*["\']?(?<depName>[^\\s"\']+)["\']?\\s*\\n\\s*tag:\\s*["\']?(?<currentValue>[^\\s"\']+)["\']?',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      // First-party images are bumped by each app repo's own CI, and the
      // Renovate token cannot read these private packages anyway.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/paulkiernan/**',
      ],
      enabled: false,
    },
    {
      matchDatasources: [
        'helm',
      ],
      separateMinorPatch: true,
      ignoreDeprecated: true,
    },
    {
      matchDatasources: [
        'docker',
      ],
      enabled: true,
      commitMessageTopic: 'container image {{depName}}',
      commitMessageExtra: 'to {{#if isSingleVersion}}v{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}',
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'renovate/image',
        'dep/major',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      labels: [
        'renovate/image',
        'dep/minor',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      labels: [
        'renovate/image',
        'dep/patch',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'renovate/helm',
        'dep/major',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      labels: [
        'renovate/helm',
        'dep/minor',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      labels: [
        'renovate/helm',
        'dep/patch',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      automerge: true,
      automergeType: 'pr',
    },
    {
      // A major database bump cannot reuse the existing data directory
      // (postgres 18 refused alexispaul's v17 data in #849), so these wait for
      // approval on the dashboard and are never automerged.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'postgres',
        'mariadb',
        'mysql',
        'mongo',
        '**/postgres',
        '**/mariadb',
        '**/mysql',
        '**/mongo',
      ],
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
      automerge: false,
      prBodyNotes: [
        '⚠️ Major database upgrade: the new version will not start on the existing data directory. Dump/restore or pg_upgrade before merging.',
      ],
    },
    {
      matchManagers: [
        'pipenv',
        'poetry',
      ],
      enabled: true,
      automerge: true,
      automergeType: 'branch',
    },
  ],
}
