{
  enabled: true,
  semanticCommits: 'enabled',
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Renovate Dashboard',
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  rebaseWhen: 'conflicted',
  prCreation: 'immediate',
  prConcurrentLimit: 0,
  platformAutomerge: true,
  automergeStrategy: 'squash',
  argocd: {
    managerFilePatterns: [
      '/kubernetes/argocd/apps/.+\\.yaml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/kubernetes/.+\\.yaml$/',
    ],
  },
  customManagers: [
    {
      // Images set as repository/tag pairs in Helm values inside Argo CD
      // Applications (e.g. cloudflared, grafana-image-renderer) are invisible
      // to the argocd and kubernetes managers.
      customType: 'regex',
      managerFilePatterns: [
        '/kubernetes/argocd/apps/.+/application\\.yaml$/',
      ],
      matchStrings: [
        'repository:\\s*["\']?(?<depName>[^\\s"\']+)["\']?\\s*\\n\\s*tag:\\s*["\']?(?<currentValue>[^\\s"\']+)["\']?',
      ],
      datasourceTemplate: 'docker',
    },
    {
      // The Immich chart defaults each component's image repository, so the
      // values only pin `tag:` and neither the kubernetes manager nor the
      // repository/tag regex above can see them. Anchored on the component key
      // because both tags share a value and each is rewritten in place.
      customType: 'regex',
      managerFilePatterns: [
        '/kubernetes/argocd/apps/workloads/immich/application\\.yaml$/',
      ],
      matchStrings: [
        '\\n\\s*server:\\s*\\n[\\s\\S]*?\\n\\s*tag:\\s*["\']?(?<currentValue>[^\\s"\']+)["\']?',
      ],
      depNameTemplate: 'ghcr.io/immich-app/immich-server',
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/kubernetes/argocd/apps/workloads/immich/application\\.yaml$/',
      ],
      matchStrings: [
        '\\n\\s*machine-learning:\\s*\\n[\\s\\S]*?\\n\\s*tag:\\s*["\']?(?<currentValue>[^\\s"\']+)["\']?',
      ],
      depNameTemplate: 'ghcr.io/immich-app/immich-machine-learning',
      datasourceTemplate: 'docker',
    },
    {
      // Same tag-only shape as Immich: the chart supplies the repository.
      customType: 'regex',
      managerFilePatterns: [
        '/kubernetes/argocd/apps/monitoring/uptime-kuma/application\\.yaml$/',
      ],
      matchStrings: [
        'image:\\s*\\n\\s*tag:\\s*["\']?(?<currentValue>[^\\s"\']+)["\']?',
      ],
      depNameTemplate: 'louislam/uptime-kuma',
      datasourceTemplate: 'docker',
    },
    {
      // CloudNativePG Clusters set `imageName`, which the kubernetes manager
      // ignores because it only looks for `image`.
      customType: 'regex',
      managerFilePatterns: [
        '/kubernetes/.+\\.yaml$/',
      ],
      matchStrings: [
        'imageName:\\s*["\']?(?<depName>[^\\s"\':]+):(?<currentValue>[^\\s"\'@]+)["\']?',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      // First-party images are bumped by each app repo's own CI, and the
      // Renovate token cannot read these private packages anyway.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/paulkiernan/**',
      ],
      enabled: false,
    },
    {
      matchDatasources: [
        'helm',
      ],
      separateMinorPatch: true,
      ignoreDeprecated: true,
    },
    {
      matchDatasources: [
        'docker',
      ],
      enabled: true,
      commitMessageTopic: 'container image {{depName}}',
      commitMessageExtra: 'to {{#if isSingleVersion}}v{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}',
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'renovate/image',
        'dep/major',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      labels: [
        'renovate/image',
        'dep/minor',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      labels: [
        'renovate/image',
        'dep/patch',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'renovate/helm',
        'dep/major',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      labels: [
        'renovate/helm',
        'dep/minor',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      labels: [
        'renovate/helm',
        'dep/patch',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      automerge: true,
      automergeType: 'pr',
    },
    {
      // A major database bump cannot reuse the existing data directory
      // (postgres 18 refused alexispaul's v17 data in #849), so these wait for
      // approval on the dashboard and are never automerged.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'postgres',
        'mariadb',
        'mysql',
        'mongo',
        '**/postgres',
        '**/mariadb',
        '**/mysql',
        '**/mongo',
        'ghcr.io/cloudnative-pg/postgresql',
        'ghcr.io/tensorchord/**',
      ],
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
      automerge: false,
      prBodyNotes: [
        '⚠️ Major database upgrade: the new version will not start on the existing data directory. Dump/restore or pg_upgrade before merging.',
      ],
    },
    {
      // Data-bearing images run on-disk migrations or need a matching extension
      // build, so even minor and patch bumps get a human.
      matchPackageNames: [
        'postgres',
        'mariadb',
        'mysql',
        'mongo',
        '**/postgres',
        '**/mariadb',
        '**/mysql',
        '**/mongo',
        'ghcr.io/cloudnative-pg/postgresql',
        'ghcr.io/tensorchord/**',
        'couchdb',
      ],
      automerge: false,
    },
    {
      // <postgres major>.<minor>-<vectorchord version>. Docker versioning reads
      // the VectorChord half as an opaque suffix and would never bump it.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/tensorchord/cloudnative-vectorchord',
      ],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d+)\\.(?<build>\\d+)\\.(?<revision>\\d+)$',
    },
    {
      // Immich upgrades can carry database migrations and breaking changes, and
      // the server and machine-learning images must stay on the same version.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/immich-app/immich-server',
        'ghcr.io/immich-app/immich-machine-learning',
      ],
      groupName: 'immich',
      prBodyNotes: [
        '⚠️ Read the Immich release notes for breaking changes and database requirements before merging.',
      ],
    },
    {
      // Covers the chart as well as the images.
      matchPackageNames: [
        'ghcr.io/immich-app/**',
      ],
      automerge: false,
    },
    {
      matchManagers: [
        'pipenv',
        'poetry',
      ],
      enabled: true,
      automerge: true,
      automergeType: 'branch',
    },
  ],
}
