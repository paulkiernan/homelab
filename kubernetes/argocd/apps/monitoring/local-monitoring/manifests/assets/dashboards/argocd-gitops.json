{
  "uid": "homelab-argocd-gitops",
  "title": "ArgoCD / GitOps",
  "description": "Is the repository still being applied? Reconciliation state of every ArgoCD Application, from the argocd-metrics scrape. Backs the alerts in alerts/argocd-gitops.yaml.",
  "tags": [
    "homelab",
    "argocd",
    "gitops"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "id": 1,
      "title": "Applications",
      "description": "Applications the controller is reporting on.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "market-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "market-prometheus"
          },
          "editorMode": "code",
          "expr": "count(argocd_app_info{job=\"argocd-metrics\"})",
          "instant": true,
          "range": false,
          "legendFormat": "apps"
        }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Manifest errors",
      "description": "Applications at sync_status=Unknown: ArgoCD cannot render or diff them, so it has stopped reconciling them entirely. Any value above zero means the repository is not the source of truth for those apps. Alert: HomelabArgoCDAppManifestError.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "market-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "market-prometheus"
          },
          "editorMode": "code",
          "expr": "count(argocd_app_info{job=\"argocd-metrics\", sync_status=\"Unknown\"}) or vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "unknown"
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Not Healthy",
      "description": "Applications whose health roll-up is not Healthy (Degraded, Progressing, Missing, Unknown, Suspended). Alerts: HomelabArgoCDAppDegraded, HomelabArgoCDAppMissing, HomelabArgoCDAppStuckProgressing.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "market-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "market-prometheus"
          },
          "editorMode": "code",
          "expr": "count(argocd_app_info{job=\"argocd-metrics\", health_status!=\"Healthy\"}) or vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "unhealthy"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Not Synced",
      "description": "Applications not at sync_status=Synced, including the Unknown ones counted separately on the left. Apps with auto-sync disabled sit here as their normal state, which is why the alert HomelabArgoCDAppOutOfSync filters on autosync_enabled.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "market-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "market-prometheus"
          },
          "editorMode": "code",
          "expr": "count(argocd_app_info{job=\"argocd-metrics\", sync_status!=\"Synced\"}) or vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "out of sync"
        }
      ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Controller scrape",
      "description": "Whether the application controller is being scraped at all. Every other panel and every GitOps alert is blind when this is Down, and the alert rules are emitted with noDataState=OK, so they go quiet rather than firing. Alert: HomelabArgoCDControllerDown.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "market-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "market-prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=\"argocd-metrics\"}",
          "instant": true,
          "range": false,
          "legendFormat": "up"
        }
      ]
    },
    {
      "type": "table",
      "id": 6,
      "title": "Applications needing attention",
      "description": "Every Application that is not both Healthy and Synced, with the labels needed to act on it. Empty is the healthy state. Sync=Unknown is the quiet failure: the workload can be Healthy while ArgoCD has stopped applying the repository to it.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "market-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Sync"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Unknown": {
                        "text": "Unknown (cannot diff)",
                        "color": "red",
                        "index": 0
                      },
                      "OutOfSync": {
                        "text": "OutOfSync",
                        "color": "yellow",
                        "index": 1
                      },
                      "Synced": {
                        "text": "Synced",
                        "color": "green",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Degraded": {
                        "text": "Degraded",
                        "color": "red",
                        "index": 0
                      },
                      "Missing": {
                        "text": "Missing",
                        "color": "orange",
                        "index": 1
                      },
                      "Progressing": {
                        "text": "Progressing",
                        "color": "blue",
                        "index": 2
                      },
                      "Unknown": {
                        "text": "Unknown",
                        "color": "purple",
                        "index": 3
                      },
                      "Healthy": {
                        "text": "Healthy",
                        "color": "green",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Sync",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "market-prometheus"
          },
          "editorMode": "code",
          "expr": "argocd_app_info{job=\"argocd-metrics\", health_status!=\"Healthy\"} or argocd_app_info{job=\"argocd-metrics\", sync_status!=\"Synced\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "cluster": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "k8s_cluster_name": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "dest_server": true,
              "operation": true
            },
            "renameByName": {
              "autosync_enabled": "Auto-sync",
              "dest_namespace": "Target namespace",
              "health_status": "Health",
              "name": "Application",
              "project": "Project",
              "repo": "Repository",
              "sync_status": "Sync"
            },
            "indexByName": {
              "name": 0,
              "health_status": 1,
              "sync_status": 2,
              "autosync_enabled": 3,
              "project": 4,
              "dest_namespace": 5,
              "repo": 6
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Health status over time",
      "description": "Applications by health roll-up. A flat non-zero Degraded or Progressing band is the shape the alerts look for; brief spikes are normal rollouts.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "market-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisSoftMax": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Healthy"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Degraded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Progressing"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Missing"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "market-prometheus"
          },
          "editorMode": "code",
          "expr": "count by (health_status) (argocd_app_info{job=\"argocd-metrics\"})",
          "legendFormat": "{{health_status}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Sync status over time",
      "description": "Applications by sync status. Unknown is the band that matters: it means ArgoCD cannot compare desired to live state, so auto-sync and self-heal are both inert for those apps.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "market-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisSoftMax": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Synced"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "OutOfSync"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unknown"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "market-prometheus"
          },
          "editorMode": "code",
          "expr": "count by (sync_status) (argocd_app_info{job=\"argocd-metrics\"})",
          "legendFormat": "{{sync_status}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Sync outcomes per hour",
      "description": "Sync operations the controller completed, by phase. A Failed/Error line that keeps climbing while an app stays OutOfSync is auto-sync retrying and losing.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "market-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Succeeded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "market-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (phase) (rate(argocd_app_sync_total{job=\"argocd-metrics\"}[30m])) * 3600",
          "legendFormat": "{{phase}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Reconciliation duration",
      "description": "How long the controller takes to reconcile an application, from the argocd_app_reconcile histogram. This histogram has no per-application label, so it is a cluster-wide view: a rising p99 means the controller is struggling to keep up with the whole app set.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "market-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "market-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(argocd_app_reconcile_bucket{job=\"argocd-metrics\"}[30m])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "market-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(argocd_app_reconcile_bucket{job=\"argocd-metrics\"}[30m])))",
          "legendFormat": "p99",
          "range": true,
          "instant": false
        }
      ]
    }
  ]
}
