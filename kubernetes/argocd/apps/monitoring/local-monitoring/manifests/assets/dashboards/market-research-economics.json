    {
      "datasource": {
        "type": "prometheus",
        "uid": "market-prometheus"
      },
      "description": "1 only when the ledger status is executed_explicit_intents. 0 = empty_no_trade_intents = NOT EVALUATED: no explicit intents, so no performance exists. Production adds no fake intents and no zero-profit fallback — every N/A below means unknown or not evaluated, never 0.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "dark-orange",
                  "index": 0,
                  "text": "NOT EVALUATED"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "EVALUATED"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "no series — exporter not reporting this site",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
